FROM sheepshaver-build AS builder

FROM --platform=linux/amd64 ubuntu:24.04

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      libsdl2-2.0-0 libgtk-3-0 libglib2.0-0 \
      xvfb x11vnc novnc websockify fluxbox \
      curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/SheepShaver/src/Unix/SheepShaver /usr/local/bin/SheepShaver

WORKDIR /sheepshaver

# SheepShaver prefs file — configured at runtime via environment
# S2P_HOST and S2P_PORT control the SCSI bridge connection
RUN echo '#!/bin/bash\n\
cat > /sheepshaver/prefs << PREFS\n\
rom /sheepshaver/rom\n\
disk /sheepshaver/disk\n\
ramsize 134217728\n\
frameskip 0\n\
modelid 14\n\
cpu 4\n\
fpu true\n\
nocdrom true\n\
nosound true\n\
noclipconversion true\n\
nogui true\n\
s2p_host ${S2P_HOST:-localhost}\n\
s2p_port ${S2P_PORT:-6868}\n\
PREFS\n\
\n\
echo "SheepShaver prefs:"\n\
cat /sheepshaver/prefs\n\
echo ""\n\
\n\
# Start virtual display\n\
Xvfb :0 -screen 0 1024x768x24 &\n\
sleep 1\n\
\n\
# Start window manager (needed for SDL window)\n\
DISPLAY=:0 fluxbox &>/dev/null &\n\
\n\
# Start VNC for optional human viewing\n\
x11vnc -display :0 -forever -nopw -shared -rfbport 5900 &>/dev/null &\n\
websockify --web /usr/share/novnc 6080 localhost:5900 &>/dev/null &\n\
\n\
echo "VNC available at http://localhost:6080/vnc.html"\n\
echo "Starting SheepShaver..."\n\
\n\
DISPLAY=:0 exec /usr/local/bin/SheepShaver\n\
' > /sheepshaver/start.sh && chmod +x /sheepshaver/start.sh

EXPOSE 6080 5900

CMD ["/sheepshaver/start.sh"]
